# AI backends only (local mode removed — you must connect a model)

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI GPT
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

KUBECONFIG=~/.kube/config

# MCP / Agent mutation guardrail (keep 0 unless you intentionally execute)
K8S_UPGRADE_ALLOW_MUTATIONS=0

# Platform override (optional). Auto-detects kind|kops|eks|gke|aks|kubeadm|generic
# K8S_PLATFORM=kind
# CLUSTER_NAME=my-cluster

# Platform-specific (only what you use)
# EKS_CLUSTER_NAME=your-eks-cluster-name
# AWS_REGION=ap-south-1
# KIND_CLUSTER_NAME=kind
# KIND_UPGRADE_MODE=inplace   # default: kubeadm in-place (no data loss)
# KIND_UPGRADE_MODE=recreate  # wipe cluster (DATA LOSS)
# KOPS_CLUSTER_NAME=my.kops.example.com
# KOPS_STATE_STORE=s3://my-kops-state
